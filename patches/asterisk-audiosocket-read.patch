+/* TCP reads do not preserve AudioSocket frame boundaries. Allow scheduling and
+ * segmentation delays, but bound the whole frame so a stalled peer cannot hold
+ * the channel thread forever. Both header and payload share this deadline. */
+#define AUDIOSOCKET_FRAME_TIMEOUT_MS 1000
+
+static int audiosocket_read_exact(int fd, uint8_t *buffer, size_t length,
+	const struct timespec *started)
+{
+	size_t offset = 0;
+	while (offset < length) {
+		struct timespec now;
+		int remaining, ready;
+		ssize_t got;
+		clock_gettime(CLOCK_MONOTONIC, &now);
+		remaining = AUDIOSOCKET_FRAME_TIMEOUT_MS -
+			((now.tv_sec - started->tv_sec) * 1000 +
+			(now.tv_nsec - started->tv_nsec) / 1000000);
+		if (remaining <= 0) {
+			errno = ETIMEDOUT;
+			return -1;
+		}
+		got = read(fd, buffer + offset, length - offset);
+		if (got > 0) {
+			offset += got;
+			continue;
+		}
+		if (got == 0) {
+			return 0;
+		}
+		if (errno == EINTR) {
+			continue;
+		}
+		if (errno != EAGAIN && errno != EWOULDBLOCK) {
+			return -1;
+		}
+		ready = ast_wait_for_input(fd, remaining);
+		if (ready < 0 && errno != EINTR) {
+			return -1;
+		}
+	}
+	return 1;
+}
